diff --git a/library/reminders.py b/library/reminders.py
new file mode 100644
index 0000000..9d2409c
--- /dev/null
+++ b/library/reminders.py
@@ -0,0 +1,29 @@
+"""Reminder mails: two days before a loan is due, once per loan."""
+import datetime as dt
+
+from library.dates import format_day, today
+
+REMIND_DAYS = 2
+
+
+def due_soon(loans, on=None):
+    """Open loans due in exactly REMIND_DAYS days that got no reminder yet."""
+    day = (on or today()) + dt.timedelta(days=REMIND_DAYS)
+    return [l for l in loans if l.open and l.due_on == day and l.reminded_on is None]
+
+
+def send_reminders(store, mailer, on=None):
+    """Mails each member whose loan is due soon and marks the loan as reminded. Returns how many were sent."""
+    sent = 0
+    for loan in due_soon(store.open_loans(), on):
+        mailer.send(loan.email, f"Please return {loan.book}",
+                    f"Hi {loan.member}, {loan.book} is due on {format_day(loan.due_on)}.")
+        loan.reminded_on = on or today()
+        sent += 1
+    return sent
+
+
+def overdue(loans, on=None):
+    """Open loans past their due date, the longest overdue first."""
+    day = on or today()
+    return sorted((l for l in loans if l.open and l.due_on < day), key=lambda l: l.due_on)
diff --git a/library/status.py b/library/status.py
new file mode 100644
index 0000000..a6aab31
--- /dev/null
+++ b/library/status.py
@@ -0,0 +1,35 @@
+"""A loan's status and the moves allowed between them."""
+from enum import Enum
+
+
+class Status(str, Enum):
+    BORROWED = "borrowed"
+    REMINDED = "reminded"
+    OVERDUE = "overdue"
+    RETURNED = "returned"
+
+
+MOVES = {
+    Status.BORROWED: {Status.REMINDED, Status.OVERDUE, Status.RETURNED},
+    Status.REMINDED: {Status.OVERDUE, Status.RETURNED},
+    Status.OVERDUE: {Status.RETURNED},
+    Status.RETURNED: set(),
+}
+
+
+def move(current, new):
+    """The new status, if a loan may go there from the current one."""
+    if new not in MOVES[current]:
+        raise ValueError(f"a loan can't go from {current.value} to {new.value}")
+    return new
+
+
+def status_of(loan, on):
+    """Where a loan stands on a given day."""
+    if loan.returned_on is not None:
+        return Status.RETURNED
+    if loan.due_on < on:
+        return Status.OVERDUE
+    if loan.reminded_on is not None:
+        return Status.REMINDED
+    return Status.BORROWED
