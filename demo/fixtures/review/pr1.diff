+++ b/library/tests/test_reminders.py
@@ -0,0 +1,29 @@
+import datetime as dt
+import unittest
+
+from library.loans import Loan, LoanStore
+from library.mailer import Mailer
+from library.reminders import overdue, send_reminders
+
+MARCH_1 = dt.date(2026, 3, 1)
+
+
+class ReminderTest(unittest.TestCase):
+    def setUp(self):
+        self.store = LoanStore()
+        self.store.add(Loan(id=1, member="ada", book="SICP", email="member", borrowed_on=MARCH_1))
+        self.store.add(Loan(id=2, member="alan", book="TAOCP", email="member", borrowed_on=MARCH_1 - dt.timedelta(days=30)))
+
+    def test_reminds_two_days_before_due_once(self):
+        mailer = Mailer()
+        on = dt.date(2026, 3, 20)  # loan 1 is due on 22 March
+        self.assertEqual(send_reminders(self.store, mailer, on), 1)
+        self.assertEqual(mailer.outbox[0]["to"], "member")
+        self.assertEqual(send_reminders(self.store, mailer, on), 0)
+
+    def test_overdue_lists_the_late_loan(self):
+        self.assertEqual([l.id for l in overdue(self.store.open_loans(), dt.date(2026, 3, 20))], [2])
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/library/tests/test_status.py b/library/tests/test_status.py
new file mode 100644
index 0000000..d57dbbc
--- /dev/null
+++ b/library/tests/test_status.py
@@ -0,0 +1,21 @@
+import datetime as dt
+import unittest
+
+from library.loans import Loan
+from library.status import Status, move, status_of
+
+MARCH_1 = dt.date(2026, 3, 1)
+
+
+class StatusTest(unittest.TestCase):
+    def test_a_returned_loan_stays_returned(self):
+        with self.assertRaises(ValueError):
+            move(Status.RETURNED, Status.BORROWED)
+
+    def test_status_of_a_late_loan(self):
+        loan = Loan(id=1, member="ada", book="SICP", email="member", borrowed_on=MARCH_1)
+        self.assertEqual(status_of(loan, dt.date(2026, 3, 30)), Status.OVERDUE)
+
+
+if __name__ == "__main__":
+    unittest.main()
